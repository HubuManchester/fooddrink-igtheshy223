<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ssk.ViewModels"
             xmlns:controls="clr-namespace:ssk.Controls"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding ModeTitle}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:StringNotNullConverter x:Key="StringNotNullConverter"/>
    </ContentPage.Resources>

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <ScrollView HorizontalOptions="Fill" VerticalOptions="Fill">
            <VerticalStackLayout Padding="32,48" Spacing="20"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  MaximumWidthRequest="400"
                                  WidthRequest="400">

                <!-- User icon -->
                <Label Text="&#xf2bd;" FontFamily="FA" FontSize="64"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center" Margin="0,0,0,16" />

                <!-- Mode title -->
                <Label Text="{Binding ModeTitle}"
                       FontSize="{DynamicResource Font28}" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,0,0,24" />

                <!-- Username -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                    <Label Text="Username" FontSize="{DynamicResource Font13}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    <controls:VoiceEntry Text="{Binding Username}"
                           FontSize="{DynamicResource Font15}"
                           Placeholder="Please input username"
                           AutomationId="LoginUsernameEntry" />
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                    <Label Text="Password" FontSize="{DynamicResource Font13}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    <Entry Text="{Binding Password}"
                           IsPassword="True"
                           FontSize="{DynamicResource Font15}"
                           Placeholder="Please input password"
                           AutomationId="LoginPasswordEntry" />
                </VerticalStackLayout>

                <!-- Confirm password (register mode only) -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Fill"
                                     IsVisible="{Binding ShowConfirmPassword}">
                    <Label Text="Confirm Password" FontSize="{DynamicResource Font13}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    <Entry Text="{Binding ConfirmPassword}"
                           IsPassword="True"
                           FontSize="{DynamicResource Font15}"
                           Placeholder="Please input password again"
                           AutomationId="LoginConfirmPasswordEntry" />
                </VerticalStackLayout>

                <!-- Error message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#EF4444"
                       FontSize="{DynamicResource Font13}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullConverter}}"
                       HorizontalOptions="Center"
                       Margin="0,4" />

                <!-- Login button -->
                <Button Text="{Binding ModeTitle}"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="{DynamicResource Font16}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Margin="0,8"
                        IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}"
                        AutomationId="LoginSubmitButton" />

                <!-- Register button -->
                <Button Text="{Binding ModeTitle}"
                        Command="{Binding RegisterCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="{DynamicResource Font16}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Margin="0,8"
                        IsVisible="{Binding IsRegisterMode}"
                        AutomationId="RegisterSubmitButton" />

                <!-- Toggle mode link -->
                <Label Text="{Binding ToggleText}"
                       FontSize="{DynamicResource Font14}"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       Margin="0,8">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleModeCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
