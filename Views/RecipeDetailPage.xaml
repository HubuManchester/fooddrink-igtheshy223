<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ssk.ViewModels"
             xmlns:models="clr-namespace:ssk.Models"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Views.RecipeDetailPage"
             x:DataType="viewmodels:RecipeDetailViewModel"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <converters:StringToUriConverter x:Key="StringToUriConverter"/>
        <converters:BoolToColorConverter x:Key="FavoriteColorConverter" TrueColor="#EF4444" FalseColor="#9CA3AF"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Row 0: Layout switch by device type -->
        <OnIdiom x:TypeArguments="View" Grid.Row="0">

            <!-- ==================== Phone layout: keep original ==================== -->
            <OnIdiom.Phone>
                <ScrollView>
                    <VerticalStackLayout Spacing="0">

                        <!-- Top image area 250 height -->
                        <Grid HeightRequest="250">
                            <!-- Bottom error placeholder -->
                            <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="&#xf127;" FontFamily="FA" FontSize="36"
                                           TextColor="#9CA3AF" HorizontalOptions="Center" />
                                    <Label Text="Image Load Fail" FontSize="{DynamicResource Font12}"
                                           TextColor="#9CA3AF" HorizontalOptions="Center" />
                                    <Label Text="Please Check Network" FontSize="{DynamicResource Font11}"
                                           TextColor="#9CA3AF" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- Top image -->
                            <Image Source="{Binding CurrentRecipe.ImagePath, Converter={StaticResource StringToUriConverter}}"
                                   Aspect="AspectFill"
                                   HeightRequest="250"
                                   HorizontalOptions="Fill" />

                            <!-- Top-left back button -->
                            <Border HorizontalOptions="Start" VerticalOptions="Start"
                                    Margin="16,40"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="#80000000"
                                    StrokeThickness="0"
                                    AutomationId="BtnBack">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xf060;" FontFamily="FA" FontSize="16"
                                       TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Top-right favorite button -->
                            <Border HorizontalOptions="End" VerticalOptions="Start"
                                    Margin="16,40"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="#80000000"
                                    StrokeThickness="0"
                                    AutomationId="BtnFavorite">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xf004;" FontFamily="FA" FontSize="18"
                                       TextColor="{Binding CurrentRecipe.IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Info area -->
                        <VerticalStackLayout Padding="20" Spacing="16">

                            <!-- Title + Description -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CurrentRecipe.Title}"
                                       FontSize="{DynamicResource Font22}" FontAttributes="Bold"
                                       SemanticProperties.HeadingLevel="Level1"
                                       AutomationId="LblRecipeTitle" />
                                <Label Text="{Binding CurrentRecipe.Description}"
                                       FontSize="{DynamicResource Font14}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       LineBreakMode="WordWrap"
                                       AutomationId="LblRecipeDesc" />
                            </VerticalStackLayout>

                            <!-- Tags -->
                            <HorizontalStackLayout Spacing="8"
                                                   BindableLayout.ItemsSource="{Binding TagList}"
                                                   AutomationId="TagsLayout">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                Padding="12,4"
                                                StrokeThickness="0">
                                            <Label Text="{Binding .}" FontSize="{DynamicResource Font12}"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!-- 3 info items in a row -->
                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,4">
                                <!-- Prep time -->
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf017;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.PrepTimeMin, StringFormat='Prep {0} min'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                                <!-- Cook time -->
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf2dc;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.CookTimeMin, StringFormat='Cook {0} min'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                                <!-- Servings -->
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf0c0;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.Servings, StringFormat='{0} serving'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Divider -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                                     Margin="0,4" />

                            <!-- Cooking Step section -->
                            <Label Text="Cooking Step"
                                   FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                                   SemanticProperties.HeadingLevel="Level2"
                                   AutomationId="LblSteps" />

                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding Steps}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StepModel">
                                        <VerticalStackLayout>
                                            <Grid ColumnDefinitions="36,*"
                                                  ColumnSpacing="12"
                                                  Padding="0,8">
                                                <!-- Step number circle -->
                                                <Border Grid.Column="0"
                                                        StrokeShape="RoundRectangle 16"
                                                        WidthRequest="32" HeightRequest="32"
                                                        BackgroundColor="{StaticResource PrimaryLight}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Start">
                                                    <Label Text="{Binding Index, StringFormat='{}{0}'}"
                                                           FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <!-- Step text -->
                                                <Label Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       FontSize="{DynamicResource Font14}"
                                                       LineBreakMode="WordWrap"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <!-- Divider (not last item) -->
                                            <BoxView HeightRequest="1"
                                                     BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                                     Margin="48,4,0,4" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Divider -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                                     Margin="0,8" />

                            <!-- Nutrition Info card -->
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                                            Offset="0,2" Radius="8" Opacity="0.3"/>
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Nutrition Info"
                                           FontSize="{DynamicResource Font16}" FontAttributes="Bold" />
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <!-- Calorie -->
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf06d;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionCalories}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Calories, StringFormat='{}{0:F0}'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="kcal" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Protein -->
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf0c0;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionProtein}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Protein, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Protein" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Carb -->
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf0e7;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionCarbs}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Carbs, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Carb" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="16">
                                        <!-- Fat -->
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf043;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionFat}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Fat, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Fat" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Fiber -->
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf06c;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionFiber}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Fiber, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Fiber" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bottom space for fixed action bar -->
                            <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </OnIdiom.Phone>

            <!-- ==================== Tablet/Desktop layout: two-column split ==================== -->
            <OnIdiom.Tablet>
                <Grid ColumnDefinitions="55*,45*"
                      ColumnSpacing="0"
                      MaximumWidthRequest="1200"
                      HorizontalOptions="Center">

                    <!-- Left column: Large image + Cooking steps -->
                    <ScrollView Grid.Column="0">
                        <VerticalStackLayout Spacing="0">

                            <!-- Top image area 300 height -->
                            <Grid HeightRequest="300">
                                <!-- Bottom error placeholder -->
                                <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}">
                                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="&#xf127;" FontFamily="FA" FontSize="36"
                                               TextColor="#9CA3AF" HorizontalOptions="Center" />
                                        <Label Text="Image Load Fail" FontSize="{DynamicResource Font12}"
                                               TextColor="#9CA3AF" HorizontalOptions="Center" />
                                        <Label Text="Please Check Network" FontSize="{DynamicResource Font11}"
                                               TextColor="#9CA3AF" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <!-- Top image -->
                                <Image Source="{Binding CurrentRecipe.ImagePath, Converter={StaticResource StringToUriConverter}}"
                                       Aspect="AspectFill"
                                       HeightRequest="300"
                                       HorizontalOptions="Fill" />

                                <!-- Top-left back button -->
                                <Border HorizontalOptions="Start" VerticalOptions="Start"
                                        Margin="16,40"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="#80000000"
                                        StrokeThickness="0"
                                        AutomationId="BtnBack">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xf060;" FontFamily="FA" FontSize="16"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <!-- Top-right favorite button -->
                                <Border HorizontalOptions="End" VerticalOptions="Start"
                                        Margin="16,40"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="#80000000"
                                        StrokeThickness="0"
                                        AutomationId="BtnFavorite">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xf004;" FontFamily="FA" FontSize="18"
                                           TextColor="{Binding CurrentRecipe.IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Cooking Step section -->
                            <VerticalStackLayout Padding="20" Spacing="16">
                                <Label Text="Cooking Step"
                                       FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                                       SemanticProperties.HeadingLevel="Level2"
                                       AutomationId="LblSteps" />

                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Steps}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:StepModel">
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="36,*"
                                                      ColumnSpacing="12"
                                                      Padding="0,8">
                                                    <!-- Step number circle -->
                                                    <Border Grid.Column="0"
                                                            StrokeShape="RoundRectangle 16"
                                                            WidthRequest="32" HeightRequest="32"
                                                            BackgroundColor="{StaticResource PrimaryLight}"
                                                            StrokeThickness="0"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Start">
                                                        <Label Text="{Binding Index, StringFormat='{}{0}'}"
                                                               FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <!-- Step text -->
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           FontSize="{DynamicResource Font14}"
                                                           LineBreakMode="WordWrap"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                                <!-- Divider (not last item) -->
                                                <BoxView HeightRequest="1"
                                                         BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                                         Margin="48,4,0,4" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Bottom space for fixed action bar -->
                                <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Right column: Title, description, tags, time info, nutrition card -->
                    <ScrollView Grid.Column="1">
                        <VerticalStackLayout Padding="20" Spacing="16">

                            <!-- Title + Description -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CurrentRecipe.Title}"
                                       FontSize="{DynamicResource Font22}" FontAttributes="Bold"
                                       SemanticProperties.HeadingLevel="Level1"
                                       AutomationId="LblRecipeTitle" />
                                <Label Text="{Binding CurrentRecipe.Description}"
                                       FontSize="{DynamicResource Font14}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       LineBreakMode="WordWrap"
                                       AutomationId="LblRecipeDesc" />
                            </VerticalStackLayout>

                            <!-- Tags -->
                            <HorizontalStackLayout Spacing="8"
                                                   BindableLayout.ItemsSource="{Binding TagList}"
                                                   AutomationId="TagsLayout">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                Padding="12,4"
                                                StrokeThickness="0">
                                            <Label Text="{Binding .}" FontSize="{DynamicResource Font12}"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!-- 3 info items in a row -->
                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,4">
                                <!-- Prep time -->
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf017;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.PrepTimeMin, StringFormat='Prep {0} min'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                                <!-- Cook time -->
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf2dc;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.CookTimeMin, StringFormat='Cook {0} min'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                                <!-- Servings -->
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf0c0;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.Servings, StringFormat='{0} serving'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Divider -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                                     Margin="0,4" />

                            <!-- Nutrition Info card -->
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                                            Offset="0,2" Radius="8" Opacity="0.3"/>
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Nutrition Info"
                                           FontSize="{DynamicResource Font16}" FontAttributes="Bold" />
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <!-- Calorie -->
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf06d;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionCalories}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Calories, StringFormat='{}{0:F0}'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="kcal" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Protein -->
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf0c0;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionProtein}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Protein, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Protein" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Carb -->
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf0e7;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionCarbs}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Carbs, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Carb" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="16">
                                        <!-- Fat -->
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf043;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionFat}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Fat, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Fat" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Fiber -->
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf06c;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionFiber}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Fiber, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Fiber" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bottom space for fixed action bar -->
                            <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </OnIdiom.Tablet>

            <!-- ==================== Desktop layout: same as tablet ==================== -->
            <OnIdiom.Desktop>
                <Grid ColumnDefinitions="55*,45*"
                      ColumnSpacing="0"
                      MaximumWidthRequest="1200"
                      HorizontalOptions="Center">

                    <!-- Left column: Large image + Cooking steps -->
                    <ScrollView Grid.Column="0">
                        <VerticalStackLayout Spacing="0">

                            <!-- Top image area 300 height -->
                            <Grid HeightRequest="300">
                                <!-- Bottom error placeholder -->
                                <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}">
                                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="&#xf127;" FontFamily="FA" FontSize="36"
                                               TextColor="#9CA3AF" HorizontalOptions="Center" />
                                        <Label Text="Image Load Fail" FontSize="{DynamicResource Font12}"
                                               TextColor="#9CA3AF" HorizontalOptions="Center" />
                                        <Label Text="Please Check Network" FontSize="{DynamicResource Font11}"
                                               TextColor="#9CA3AF" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <!-- Top image -->
                                <Image Source="{Binding CurrentRecipe.ImagePath, Converter={StaticResource StringToUriConverter}}"
                                       Aspect="AspectFill"
                                       HeightRequest="300"
                                       HorizontalOptions="Fill" />

                                <!-- Top-left back button -->
                                <Border HorizontalOptions="Start" VerticalOptions="Start"
                                        Margin="16,40"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="#80000000"
                                        StrokeThickness="0"
                                        AutomationId="BtnBack">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xf060;" FontFamily="FA" FontSize="16"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <!-- Top-right favorite button -->
                                <Border HorizontalOptions="End" VerticalOptions="Start"
                                        Margin="16,40"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="#80000000"
                                        StrokeThickness="0"
                                        AutomationId="BtnFavorite">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xf004;" FontFamily="FA" FontSize="18"
                                           TextColor="{Binding CurrentRecipe.IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Cooking Step section -->
                            <VerticalStackLayout Padding="20" Spacing="16">
                                <Label Text="Cooking Step"
                                       FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                                       SemanticProperties.HeadingLevel="Level2"
                                       AutomationId="LblSteps" />

                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Steps}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:StepModel">
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="36,*"
                                                      ColumnSpacing="12"
                                                      Padding="0,8">
                                                    <!-- Step number circle -->
                                                    <Border Grid.Column="0"
                                                            StrokeShape="RoundRectangle 16"
                                                            WidthRequest="32" HeightRequest="32"
                                                            BackgroundColor="{StaticResource PrimaryLight}"
                                                            StrokeThickness="0"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Start">
                                                        <Label Text="{Binding Index, StringFormat='{}{0}'}"
                                                               FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <!-- Step text -->
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           FontSize="{DynamicResource Font14}"
                                                           LineBreakMode="WordWrap"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                                <!-- Divider (not last item) -->
                                                <BoxView HeightRequest="1"
                                                         BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                                         Margin="48,4,0,4" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Bottom space for fixed action bar -->
                                <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Right column: Title, description, tags, time info, nutrition card -->
                    <ScrollView Grid.Column="1">
                        <VerticalStackLayout Padding="20" Spacing="16">

                            <!-- Title + Description -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CurrentRecipe.Title}"
                                       FontSize="{DynamicResource Font22}" FontAttributes="Bold"
                                       SemanticProperties.HeadingLevel="Level1"
                                       AutomationId="LblRecipeTitle" />
                                <Label Text="{Binding CurrentRecipe.Description}"
                                       FontSize="{DynamicResource Font14}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       LineBreakMode="WordWrap"
                                       AutomationId="LblRecipeDesc" />
                            </VerticalStackLayout>

                            <!-- Tags -->
                            <HorizontalStackLayout Spacing="8"
                                                   BindableLayout.ItemsSource="{Binding TagList}"
                                                   AutomationId="TagsLayout">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                Padding="12,4"
                                                StrokeThickness="0">
                                            <Label Text="{Binding .}" FontSize="{DynamicResource Font12}"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!-- 3 info items in a row -->
                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,4">
                                <!-- Prep time -->
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf017;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.PrepTimeMin, StringFormat='Prep {0} min'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                                <!-- Cook time -->
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf2dc;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.CookTimeMin, StringFormat='Cook {0} min'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                                <!-- Servings -->
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="&#xf0c0;" FontFamily="FA" FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentRecipe.Servings, StringFormat='{0} serving'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Divider -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                                     Margin="0,4" />

                            <!-- Nutrition Info card -->
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                                            Offset="0,2" Radius="8" Opacity="0.3"/>
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Nutrition Info"
                                           FontSize="{DynamicResource Font16}" FontAttributes="Bold" />
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <!-- Calorie -->
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf06d;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionCalories}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Calories, StringFormat='{}{0:F0}'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="kcal" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Protein -->
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf0c0;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionProtein}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Protein, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Protein" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Carb -->
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf0e7;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionCarbs}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Carbs, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Carb" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="16">
                                        <!-- Fat -->
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf043;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionFat}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Fat, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Fat" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <!-- Fiber -->
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="&#xf06c;" FontFamily="FA" FontSize="16"
                                                   TextColor="{StaticResource NutritionFiber}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Nutrition.Fiber, StringFormat='{}{0:F1}g'}"
                                                   FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                            <Label Text="Fiber" FontSize="{DynamicResource Font11}"
                                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bottom space for fixed action bar -->
                            <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </OnIdiom.Desktop>

        </OnIdiom>

        <!-- Bottom fixed action bar (shared by all devices) -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="16,12"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <Grid.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                        Offset="0,-2" Radius="8" Opacity="0.3"/>
            </Grid.Shadow>

            <!-- Read aloud/Stop reading -->
            <Button Grid.Column="0"
                    Text="{Binding SpeakButtonText}"
                    Command="{Binding ToggleSpeakingCommand}"
                    FontFamily="FA"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    BorderColor="{StaticResource Primary}"
                    BorderWidth="1"
                    CornerRadius="12"
                    FontSize="14"
                    SemanticProperties.Hint="Read cooking step aloud"
                    AutomationId="BtnSpeak" />

            <!-- Add to diet plan -->
            <Button Grid.Column="1"
                    Text="&#xf067; Add To Diet Plan"
                    Command="{Binding AddToPlanCommand}"
                    FontFamily="FA"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    FontSize="14"
                    FontAttributes="Bold"
                    SemanticProperties.Hint="Add to diet plan"
                    AutomationId="BtnAddToPlan" />
        </Grid>
    </Grid>
</ContentPage>
