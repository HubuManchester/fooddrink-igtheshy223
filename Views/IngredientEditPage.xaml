<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ssk.Controls"
             x:Class="ssk.Views.IngredientEditPage"
             Title="编辑食材">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <!-- 名称 -->
            <VerticalStackLayout Spacing="4">
                <Label Text="食材名称" FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                <controls:VoiceEntry AutomationId="IngredientNameEntry"
                       Placeholder="请输入食材名称"
                       Text="{Binding Name}"
                       FontSize="{DynamicResource Font15}" />
            </VerticalStackLayout>

            <!-- 分类 -->
            <VerticalStackLayout Spacing="4">
                <Label Text="分类" FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                <Picker AutomationId="IngredientCategoryPicker"
                        Title="选择分类"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}" />
            </VerticalStackLayout>

            <!-- 数量 + 单位 -->
            <Grid ColumnDefinitions="*,16,*" ColumnSpacing="16">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="数量" FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                    <Entry AutomationId="IngredientQuantityEntry"
                           Placeholder="数量"
                           Text="{Binding Quantity}"
                           Keyboard="Numeric"
                           FontSize="{DynamicResource Font15}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="4">
                    <Label Text="单位" FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                    <Picker AutomationId="IngredientUnitPicker"
                            Title="选择单位"
                            ItemsSource="{Binding Units}"
                            SelectedItem="{Binding SelectedUnit}" />
                </VerticalStackLayout>
            </Grid>

            <!-- 购买日期 -->
            <VerticalStackLayout Spacing="4">
                <Label Text="购买日期" FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                <DatePicker AutomationId="PurchaseDatePicker"
                            Date="{Binding PurchaseDate}"
                            Format="yyyy-MM-dd" />
            </VerticalStackLayout>

            <!-- 过期日期 -->
            <VerticalStackLayout Spacing="4">
                <Label Text="过期日期" FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                <DatePicker AutomationId="ExpiryDatePicker"
                            Date="{Binding ExpiryDate}"
                            Format="yyyy-MM-dd" />
            </VerticalStackLayout>

            <!-- 存储位置 -->
            <VerticalStackLayout Spacing="4">
                <Label Text="存储位置" FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                <Picker AutomationId="StorageLocationPicker"
                        Title="选择存储位置"
                        ItemsSource="{Binding StorageLocations}"
                        SelectedItem="{Binding SelectedStorage}" />
            </VerticalStackLayout>

            <!-- 取消 / 保存按钮 -->
            <Grid ColumnDefinitions="*,16,*" ColumnSpacing="16" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        AutomationId="CancelButton"
                        Text="取消"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                        TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
                        CornerRadius="10"
                        HeightRequest="48" />
                <Button Grid.Column="1"
                        AutomationId="SaveButton"
                        Text="保存"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="48" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
