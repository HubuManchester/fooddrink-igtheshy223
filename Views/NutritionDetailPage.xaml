<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ssk.Views.NutritionDetailPage"
             Title="Nutrition Detail">

    <ScrollView Padding="16">
        <OnIdiom x:TypeArguments="View">
            <!-- Phone layout: original single column vertical stack -->
            <OnIdiom.Phone>
                <VerticalStackLayout Spacing="16">
                    <!-- Today nutrition summary -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Today Nutrition Summary" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <!-- Nutrient detail Grid -->
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="8">
                                <!-- Header -->
                                <Label Grid.Row="0" Grid.Column="0" Text="Nutrient" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="Intake" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="2" Text="Target" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="3" Text="Progress" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

                                <!-- Calorie -->
                                <Label Grid.Row="1" Grid.Column="0" Text="Calorie" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding CaloriesIntake, StringFormat='{0}'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding CaloriesTarget, StringFormat='{0}'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="1" Grid.Column="3" Progress="{Binding CaloriesProgress}" Margin="4,0" />

                                <!-- Protein -->
                                <Label Grid.Row="2" Grid.Column="0" Text="Protein" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProteinIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#EF4444" />
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding ProteinTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="2" Grid.Column="3" Progress="{Binding ProteinProgress}" Margin="4,0" />

                                <!-- Carb -->
                                <Label Grid.Row="3" Grid.Column="0" Text="Carb" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding CarbsIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#F59E0B" />
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding CarbsTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="3" Grid.Column="3" Progress="{Binding CarbsProgress}" Margin="4,0" />

                                <!-- Fat -->
                                <Label Grid.Row="4" Grid.Column="0" Text="Fat" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding FatIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#10B981" />
                                <Label Grid.Row="4" Grid.Column="2" Text="{Binding FatTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="4" Grid.Column="3" Progress="{Binding FatProgress}" Margin="4,0" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Calorie progress ring -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Calorie Intake" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                            <!-- Simple progress bar replacing progress ring -->
                            <ProgressBar AutomationId="CaloriesProgressBar"
                                         Progress="{Binding CaloriesProgress}"
                                         WidthRequest="280"
                                         HeightRequest="12"
                                         HorizontalOptions="Center" />
                            <Label Text="{Binding CaloriesSummary}"
                                   FontSize="{DynamicResource Font13}"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Three macros bar chart -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Three Macros Ratio" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" HeightRequest="160">
                                <!-- Protein bar -->
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding ProteinPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#EF4444" />
                                    <ProgressBar AutomationId="ProteinBar"
                                                 Progress="{Binding ProteinProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Protein" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <!-- Carb bar -->
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding CarbsPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#F59E0B" />
                                    <ProgressBar AutomationId="CarbsBar"
                                                 Progress="{Binding CarbsProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Carb" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <!-- Fat bar -->
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding FatPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#10B981" />
                                    <ProgressBar AutomationId="FatBar"
                                                 Progress="{Binding FatProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Fat" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Weekly trend -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Weekly Calorie Trend" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <!-- 7 day data row -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="100">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding MondayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Mon" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding TuesdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Tue" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding WednesdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Wed" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding ThursdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Thu" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding FridayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Fri" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="5" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding SaturdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Sat" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="6" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding SundayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Sun" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Diet suggestion -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Diet Suggestion" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <CollectionView AutomationId="SuggestionsList"
                                            ItemsSource="{Binding Suggestions}"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="8" Margin="0,4">
                                            <Label Text="&#xf0da;" FontFamily="FA" FontSize="12"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding .}" FontSize="{DynamicResource Font13}"
                                                   LineBreakMode="WordWrap"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </OnIdiom.Phone>

            <!-- Tablet/Desktop layout: 2 column grid -->
            <OnIdiom.Tablet>
                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="16" ColumnSpacing="16"
                      MaximumWidthRequest="1200" HorizontalOptions="Center">

                    <!-- Row 0 Col 0: Today nutrition summary -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Today Nutrition Summary" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="Nutrient" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="Intake" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="2" Text="Target" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="3" Text="Progress" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="Calorie" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding CaloriesIntake, StringFormat='{0}'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding CaloriesTarget, StringFormat='{0}'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="1" Grid.Column="3" Progress="{Binding CaloriesProgress}" Margin="4,0" />
                                <Label Grid.Row="2" Grid.Column="0" Text="Protein" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProteinIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#EF4444" />
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding ProteinTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="2" Grid.Column="3" Progress="{Binding ProteinProgress}" Margin="4,0" />
                                <Label Grid.Row="3" Grid.Column="0" Text="Carb" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding CarbsIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#F59E0B" />
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding CarbsTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="3" Grid.Column="3" Progress="{Binding CarbsProgress}" Margin="4,0" />
                                <Label Grid.Row="4" Grid.Column="0" Text="Fat" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding FatIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#10B981" />
                                <Label Grid.Row="4" Grid.Column="2" Text="{Binding FatTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="4" Grid.Column="3" Progress="{Binding FatProgress}" Margin="4,0" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 0 Col 1: Calorie progress -->
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Calorie Intake" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                            <ProgressBar AutomationId="CaloriesProgressBar"
                                         Progress="{Binding CaloriesProgress}"
                                         WidthRequest="280"
                                         HeightRequest="12"
                                         HorizontalOptions="Center" />
                            <Label Text="{Binding CaloriesSummary}"
                                   FontSize="{DynamicResource Font13}"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 1 Col 0: Three macros bar chart -->
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Three Macros Ratio" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" HeightRequest="160">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding ProteinPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#EF4444" />
                                    <ProgressBar AutomationId="ProteinBar"
                                                 Progress="{Binding ProteinProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Protein" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding CarbsPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#F59E0B" />
                                    <ProgressBar AutomationId="CarbsBar"
                                                 Progress="{Binding CarbsProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Carb" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding FatPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#10B981" />
                                    <ProgressBar AutomationId="FatBar"
                                                 Progress="{Binding FatProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Fat" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 1 Col 1: Weekly trend -->
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Weekly Calorie Trend" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="100">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding MondayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Mon" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding TuesdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Tue" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding WednesdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Wed" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding ThursdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Thu" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding FridayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Fri" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="5" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding SaturdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Sat" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="6" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding SundayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Sun" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 2 ColSpan 2: Diet suggestion -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Diet Suggestion" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <CollectionView AutomationId="SuggestionsList"
                                            ItemsSource="{Binding Suggestions}"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="8" Margin="0,4">
                                            <Label Text="&#xf0da;" FontFamily="FA" FontSize="12"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding .}" FontSize="{DynamicResource Font13}"
                                                   LineBreakMode="WordWrap"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </OnIdiom.Tablet>

            <!-- Desktop layout: same 2 column grid as tablet -->
            <OnIdiom.Desktop>
                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="16" ColumnSpacing="16"
                      MaximumWidthRequest="1200" HorizontalOptions="Center">

                    <!-- Row 0 Col 0: Today nutrition summary -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Today Nutrition Summary" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="Nutrient" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="Intake" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="2" Text="Target" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="0" Grid.Column="3" Text="Progress" FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="Calorie" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding CaloriesIntake, StringFormat='{0}'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding CaloriesTarget, StringFormat='{0}'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="1" Grid.Column="3" Progress="{Binding CaloriesProgress}" Margin="4,0" />
                                <Label Grid.Row="2" Grid.Column="0" Text="Protein" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProteinIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#EF4444" />
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding ProteinTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="2" Grid.Column="3" Progress="{Binding ProteinProgress}" Margin="4,0" />
                                <Label Grid.Row="3" Grid.Column="0" Text="Carb" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding CarbsIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#F59E0B" />
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding CarbsTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="3" Grid.Column="3" Progress="{Binding CarbsProgress}" Margin="4,0" />
                                <Label Grid.Row="4" Grid.Column="0" Text="Fat" FontSize="{DynamicResource Font13}" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding FatIntake, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="#10B981" />
                                <Label Grid.Row="4" Grid.Column="2" Text="{Binding FatTarget, StringFormat='{0}g'}" FontSize="{DynamicResource Font13}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                <ProgressBar Grid.Row="4" Grid.Column="3" Progress="{Binding FatProgress}" Margin="4,0" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 0 Col 1: Calorie progress -->
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Calorie Intake" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                            <ProgressBar AutomationId="CaloriesProgressBar"
                                         Progress="{Binding CaloriesProgress}"
                                         WidthRequest="280"
                                         HeightRequest="12"
                                         HorizontalOptions="Center" />
                            <Label Text="{Binding CaloriesSummary}"
                                   FontSize="{DynamicResource Font13}"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 1 Col 0: Three macros bar chart -->
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Three Macros Ratio" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" HeightRequest="160">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding ProteinPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#EF4444" />
                                    <ProgressBar AutomationId="ProteinBar"
                                                 Progress="{Binding ProteinProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Protein" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding CarbsPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#F59E0B" />
                                    <ProgressBar AutomationId="CarbsBar"
                                                 Progress="{Binding CarbsProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Carb" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="{Binding FatPercent, StringFormat='{0:P0}'}"
                                           FontSize="{DynamicResource Font12}" HorizontalOptions="Center" TextColor="#10B981" />
                                    <ProgressBar AutomationId="FatBar"
                                                 Progress="{Binding FatProgress}"
                                                 WidthRequest="60"
                                                 HeightRequest="100"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Fat" FontSize="{DynamicResource Font12}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 1 Col 1: Weekly trend -->
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Weekly Calorie Trend" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="100">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding MondayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Mon" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding TuesdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Tue" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding WednesdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Wed" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding ThursdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Thu" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding FridayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Fri" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="5" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding SaturdayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Sat" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="6" HorizontalOptions="Center" Spacing="4">
                                    <ProgressBar Progress="{Binding SundayProgress}" HeightRequest="60" WidthRequest="24"
                                                 HorizontalOptions="Center" />
                                    <Label Text="Sun" FontSize="{DynamicResource Font11}" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 2 ColSpan 2: Diet suggestion -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Diet Suggestion" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <CollectionView AutomationId="SuggestionsList"
                                            ItemsSource="{Binding Suggestions}"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="8" Margin="0,4">
                                            <Label Text="&#xf0da;" FontFamily="FA" FontSize="12"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding .}" FontSize="{DynamicResource Font13}"
                                                   LineBreakMode="WordWrap"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </OnIdiom.Desktop>
        </OnIdiom>
    </ScrollView>

</ContentPage>
