<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ssk.ViewModels"
             xmlns:models="clr-namespace:ssk.Models"
             xmlns:controls="clr-namespace:ssk.Controls"
             x:Class="ssk.Views.RecipeEditPage"
             x:DataType="viewmodels:RecipeEditViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- 食谱标题 -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="食谱标题" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                           AutomationId="LblTitle" />
                    <controls:VoiceEntry Text="{Binding Title}"
                           Placeholder="食谱标题"
                           FontSize="{DynamicResource Font16}"
                           AutomationId="EntryTitle" />
                </VerticalStackLayout>

                <!-- 描述 -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="描述" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                           AutomationId="LblDescription" />
                    <controls:VoiceEditor Text="{Binding Description}"
                            Placeholder="添加食谱描述..."
                            EditorHeight="80"
                            FontSize="{DynamicResource Font14}"
                            AutomationId="EditorDescription" />
                </VerticalStackLayout>

                <!-- 分类 + 难度 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="分类" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Picker Title="选择分类"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                SemanticProperties.Hint="选择分类"
                                AutomationId="PickerCategory" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="难度" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Picker Title="选择难度"
                                ItemsSource="{Binding Difficulties}"
                                SelectedItem="{Binding SelectedDifficulty}"
                                SemanticProperties.Hint="选择难度"
                                AutomationId="PickerDifficulty" />
                    </VerticalStackLayout>
                </Grid>

                <!-- 准备时间 + 烹饪时间 + 份数 -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="准备时间" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Entry Text="{Binding PrepTime}"
                               Placeholder="分钟"
                               Keyboard="Numeric"
                               FontSize="{DynamicResource Font14}"
                               SemanticProperties.Hint="准备时间（分钟）"
                               AutomationId="EntryPrepTime" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="烹饪时间" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Entry Text="{Binding CookTime}"
                               Placeholder="分钟"
                               Keyboard="Numeric"
                               FontSize="{DynamicResource Font14}"
                               SemanticProperties.Hint="烹饪时间（分钟）"
                               AutomationId="EntryCookTime" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="份数" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Entry Text="{Binding Servings}"
                               Placeholder="份"
                               Keyboard="Numeric"
                               FontSize="{DynamicResource Font14}"
                               SemanticProperties.Hint="份数"
                               AutomationId="EntryServings" />
                    </VerticalStackLayout>
                </Grid>

                <!-- 分隔线 -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />

                <!-- 步骤编辑区 -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="烹饪步骤"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               VerticalOptions="Center"
                               AutomationId="LblSteps" />
                        <Button Grid.Column="1"
                                Text="&#xf067; 添加步骤"
                                FontFamily="FA"
                                Command="{Binding AddStepCommand}"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                TextColor="{StaticResource Primary}"
                                FontSize="13"
                                Padding="12,6"
                                CornerRadius="8"
                                SemanticProperties.Hint="添加烹饪步骤"
                                AutomationId="BtnAddStep" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Steps}"
                                    AutomationId="StepsList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:StepModel">
                                <Grid ColumnDefinitions="32,*,40"
                                      ColumnSpacing="8"
                                      Padding="0,4">
                                    <!-- 步骤序号 -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 14"
                                            WidthRequest="28" HeightRequest="28"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeThickness="0"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Index, StringFormat='{}{0}'}"
                                               FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <!-- 步骤内容编辑器 -->
                                    <controls:VoiceEditor Grid.Column="1"
                                            Text="{Binding Text}"
                                            Placeholder="输入步骤描述..."
                                            EditorHeight="60"
                                            FontSize="{DynamicResource Font13}"
                                            AutomationId="EditorStep" />
                                    <!-- 删除按钮 -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 16"
                                            WidthRequest="32" HeightRequest="32"
                                            BackgroundColor="#FEE2E2"
                                            StrokeThickness="0"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            AutomationId="BtnRemoveStep">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RecipeEditViewModel}}, Path=RemoveStepCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="&#xf1f8;" FontFamily="FA" FontSize="14"
                                               TextColor="#EF4444"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 分隔线 -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />

                <!-- 标签 -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="标签" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                           AutomationId="LblTags" />
                    <controls:VoiceEntry Text="{Binding TagsInput}"
                           Placeholder="标签，逗号分隔"
                           FontSize="{DynamicResource Font14}"
                           AutomationId="EntryTags" />
                </VerticalStackLayout>

                <!-- 底部留白 -->
                <BoxView HeightRequest="60" BackgroundColor="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部固定按钮 -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="20,12"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <Grid.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                        Offset="0,-2" Radius="8" Opacity="0.3"/>
            </Grid.Shadow>

            <!-- 取消 -->
            <Button Grid.Column="0"
                    Text="取消"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
                    BorderColor="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    BorderWidth="1"
                    CornerRadius="12"
                    FontSize="{DynamicResource Font16}"
                    SemanticProperties.Hint="取消编辑"
                    AutomationId="BtnCancel" />

            <!-- 保存 -->
            <Button Grid.Column="1"
                    Text="&#xf0c7; 保存"
                    Command="{Binding SaveCommand}"
                    FontFamily="FA"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    FontSize="16"
                    FontAttributes="Bold"
                    SemanticProperties.Hint="保存食谱"
                    AutomationId="BtnSave" />
        </Grid>
    </Grid>
</ContentPage>
