<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ssk.ViewModels"
             xmlns:models="clr-namespace:ssk.Models"
             xmlns:controls="clr-namespace:ssk.Controls"
             x:Class="ssk.Views.RecipeEditPage"
             x:DataType="viewmodels:RecipeEditViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Recipe title -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Recipe Title" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                           AutomationId="LblTitle" />
                    <controls:VoiceEntry Text="{Binding Title}"
                           Placeholder="Recipe Title"
                           FontSize="{DynamicResource Font16}"
                           AutomationId="EntryTitle" />
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Description" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                           AutomationId="LblDescription" />
                    <controls:VoiceEditor Text="{Binding Description}"
                            Placeholder="Add recipe description..."
                            EditorHeight="80"
                            FontSize="{DynamicResource Font14}"
                            AutomationId="EditorDescription" />
                </VerticalStackLayout>

                <!-- Category + Difficulty -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Category" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Picker Title="Select Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                SemanticProperties.Hint="Select category"
                                AutomationId="PickerCategory" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Difficulty" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Picker Title="Select Difficulty"
                                ItemsSource="{Binding Difficulties}"
                                SelectedItem="{Binding SelectedDifficulty}"
                                SemanticProperties.Hint="Select difficulty"
                                AutomationId="PickerDifficulty" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Prep time + Cook time + Servings -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Prep Time" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Entry Text="{Binding PrepTime}"
                               Placeholder="min"
                               Keyboard="Numeric"
                               FontSize="{DynamicResource Font14}"
                               SemanticProperties.Hint="Prep time (min)"
                               AutomationId="EntryPrepTime" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Cook Time" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Entry Text="{Binding CookTime}"
                               Placeholder="min"
                               Keyboard="Numeric"
                               FontSize="{DynamicResource Font14}"
                               SemanticProperties.Hint="Cook time (min)"
                               AutomationId="EntryCookTime" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Servings" FontSize="{DynamicResource Font14}" FontAttributes="Bold" />
                        <Entry Text="{Binding Servings}"
                               Placeholder="serving"
                               Keyboard="Numeric"
                               FontSize="{DynamicResource Font14}"
                               SemanticProperties.Hint="Servings"
                               AutomationId="EntryServings" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />

                <!-- Step editing area -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Cooking Step"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               VerticalOptions="Center"
                               AutomationId="LblSteps" />
                        <Button Grid.Column="1"
                                Text="&#xf067; Add Step"
                                FontFamily="FA"
                                Command="{Binding AddStepCommand}"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                TextColor="{StaticResource Primary}"
                                FontSize="13"
                                Padding="12,6"
                                CornerRadius="8"
                                SemanticProperties.Hint="Add cooking step"
                                AutomationId="BtnAddStep" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Steps}"
                                    AutomationId="StepsList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:StepModel">
                                <Grid ColumnDefinitions="32,*,40"
                                      ColumnSpacing="8"
                                      Padding="0,4">
                                    <!-- Step number -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 14"
                                            WidthRequest="28" HeightRequest="28"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeThickness="0"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Index, StringFormat='{}{0}'}"
                                               FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <!-- Step content editor -->
                                    <controls:VoiceEditor Grid.Column="1"
                                            Text="{Binding Text}"
                                            Placeholder="Input step description..."
                                            EditorHeight="60"
                                            FontSize="{DynamicResource Font13}"
                                            AutomationId="EditorStep" />
                                    <!-- Delete button -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 16"
                                            WidthRequest="32" HeightRequest="32"
                                            BackgroundColor="#FEE2E2"
                                            StrokeThickness="0"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            AutomationId="BtnRemoveStep">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RecipeEditViewModel}}, Path=RemoveStepCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="&#xf1f8;" FontFamily="FA" FontSize="14"
                                               TextColor="#EF4444"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />

                <!-- Tags -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Tags" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                           AutomationId="LblTags" />
                    <controls:VoiceEntry Text="{Binding TagsInput}"
                           Placeholder="Tags, comma separated"
                           FontSize="{DynamicResource Font14}"
                           AutomationId="EntryTags" />
                </VerticalStackLayout>

                <!-- Bottom space -->
                <BoxView HeightRequest="60" BackgroundColor="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom fixed buttons -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="20,12"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <Grid.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                        Offset="0,-2" Radius="8" Opacity="0.3"/>
            </Grid.Shadow>

            <!-- Cancel -->
            <Button Grid.Column="0"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
                    BorderColor="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    BorderWidth="1"
                    CornerRadius="12"
                    FontSize="{DynamicResource Font16}"
                    SemanticProperties.Hint="Cancel edit"
                    AutomationId="BtnCancel" />

            <!-- Save -->
            <Button Grid.Column="1"
                    Text="&#xf0c7; Save"
                    Command="{Binding SaveCommand}"
                    FontFamily="FA"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    FontSize="16"
                    FontAttributes="Bold"
                    SemanticProperties.Hint="Save recipe"
                    AutomationId="BtnSave" />
        </Grid>
    </Grid>
</ContentPage>
