<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Views.CameraPage"
             Title="Photo Recognize">
    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto,Auto" Padding="16" RowSpacing="16">
        <!-- Image display area -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1F2937}">
            <Grid>
                <!-- Placeholder hint -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8"
                                     IsVisible="{Binding HasPhoto, Converter={StaticResource InverseBoolConverter}}"
                                     x:Name="PlaceholderLayout">
                    <Label Text="&#xf030;" FontFamily="FA" FontSize="48"
                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                           HorizontalOptions="Center" />
                    <Label Text="Tap button below to take photo recognize food"
                           FontSize="{DynamicResource Font14}"
                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Photo taken image -->
                <Image AutomationId="CapturedImage"
                       Source="{Binding PhotoImage}"
                       Aspect="AspectFit"
                       IsVisible="{Binding HasPhoto}" />
            </Grid>
        </Border>

        <!-- Action buttons area -->
        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="16">
            <Button AutomationId="TakePhotoButton"
                    Text="&#xf030; Take Photo"
                    FontFamily="FA"
                    Command="{Binding CaptureCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="20,12"
                    FontSize="15" />

            <Button AutomationId="PickPhotoButton"
                    Text="&#xf03e; Gallery"
                    FontFamily="FA"
                    Command="{Binding PickPhotoCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="20,12"
                    FontSize="15" />

            <Button AutomationId="FlashToggle"
                    Text="&#xf0e7; Flash"
                    FontFamily="FA"
                    Command="{Binding ToggleFlashCommand}"
                    BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
                    CornerRadius="10"
                    Padding="20,12"
                    FontSize="15">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding FlashOn}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <!-- Recognition result area -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="12"
                             IsVisible="{Binding HasResult}">
            <!-- Recognizing indicator -->
            <ActivityIndicator AutomationId="RecognizingIndicator"
                               IsRunning="{Binding IsProcessing}"
                               IsVisible="{Binding IsProcessing}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <!-- Recognition result card -->
            <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <!-- Food name + confidence -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding RecognizedFoodName}"
                               FontSize="{DynamicResource Font18}" FontAttributes="Bold" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                Padding="10,4">
                            <Label Text="{Binding Confidence, StringFormat='{0:P0}'}"
                                   FontSize="{DynamicResource Font13}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                    <!-- Nutrition info -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,4">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="{Binding Nutrition.Calories, StringFormat='{0}'}" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                            <Label Text="Calorie(kcal)" FontSize="{DynamicResource Font11}"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="{Binding Nutrition.Protein, StringFormat='{0}g'}" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="#EF4444" HorizontalOptions="Center" />
                            <Label Text="Protein" FontSize="{DynamicResource Font11}"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="{Binding Nutrition.Carbs, StringFormat='{0}g'}" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="#F59E0B" HorizontalOptions="Center" />
                            <Label Text="Carb" FontSize="{DynamicResource Font11}"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                            <Label Text="{Binding Nutrition.Fat, StringFormat='{0}g'}" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="#10B981" HorizontalOptions="Center" />
                            <Label Text="Fat" FontSize="{DynamicResource Font11}"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Action buttons -->
                    <Grid ColumnDefinitions="*,16,*" ColumnSpacing="16" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                AutomationId="AddToMealPlanButton"
                                Text="Add To Diet Plan"
                                Command="{Binding AddToPlanCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44" />
                        <Button Grid.Column="2"
                                AutomationId="ReRecognizeButton"
                                Text="Re-recognize"
                                Command="{Binding ResetCommand}"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
                                CornerRadius="10"
                                HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
