<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ssk.Controls"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Views.MealPlanPage"
             Title="Diet Plan">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid>
        <!-- Original content -->
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}"
                     IsVisible="{Binding IsLoggedIn}">
    <ScrollView>
        <OnIdiom x:TypeArguments="View">
            <!-- Phone layout: original vertical layout -->
            <OnIdiom.Phone>
    <VerticalStackLayout Padding="16,8" Spacing="12">
        <!-- Weekly calendar -->
        <controls:WeeklyCalendar
            AutomationId="WeeklyCalendar"
            SelectedDate="{Binding SelectedDate}"
            DatesWithPlans="{Binding DatesWithPlans}"
            DateSelectedCommand="{Binding DateSelectedCommand}" />

        <!-- Breakfast -->
        <controls:MealSlotView
            AutomationId="MealSlotBreakfast"
            MealType="Breakfast"
            Plans="{Binding BreakfastPlans}"
            ToggleCommand="{Binding ToggleMealCommand}" />

        <!-- Lunch -->
        <controls:MealSlotView
            AutomationId="MealSlotLunch"
            MealType="Lunch"
            Plans="{Binding LunchPlans}"
            ToggleCommand="{Binding ToggleMealCommand}" />

        <!-- Dinner -->
        <controls:MealSlotView
            AutomationId="MealSlotDinner"
            MealType="Dinner"
            Plans="{Binding DinnerPlans}"
            ToggleCommand="{Binding ToggleMealCommand}" />

        <!-- Snack -->
        <controls:MealSlotView
            AutomationId="MealSlotSnack"
            MealType="Snack"
            Plans="{Binding SnackPlans}"
            ToggleCommand="{Binding ToggleMealCommand}" />

        <!-- Nutrition summary bar -->
        <Border StrokeShape="RoundRectangle 10"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                Padding="12,8" Margin="0,4">
            <Grid ColumnDefinitions="*,*,*,*,*" HorizontalOptions="Fill">
                <!-- Calorie -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="{Binding TotalCalories, StringFormat='{0}'}"
                           FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />
                    <Label Text="Calorie"
                           FontSize="{DynamicResource Font11}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Protein -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding TotalProtein, StringFormat='{0}g'}"
                           FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                           TextColor="#EF4444"
                           HorizontalOptions="Center" />
                    <Label Text="Protein"
                           FontSize="{DynamicResource Font11}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Carb -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="{Binding TotalCarbs, StringFormat='{0}g'}"
                           FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                           TextColor="#F59E0B"
                           HorizontalOptions="Center" />
                    <Label Text="Carb"
                           FontSize="{DynamicResource Font11}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Fat -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                    <Label Text="{Binding TotalFat, StringFormat='{0}g'}"
                           FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                           TextColor="#10B981"
                           HorizontalOptions="Center" />
                    <Label Text="Fat"
                           FontSize="{DynamicResource Font11}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Fiber -->
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                    <Label Text="{Binding TotalFiber, StringFormat='{0}g'}"
                           FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                           TextColor="#8B5CF6"
                           HorizontalOptions="Center" />
                    <Label Text="Fiber"
                           FontSize="{DynamicResource Font11}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Add diet plan button -->
        <Button AutomationId="AddMealPlanButton"
                Text="+ Add Diet Plan"
                FontAttributes="Bold"
                Command="{Binding AddMealPlanCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                CornerRadius="10"
                Margin="0,8"
                HeightRequest="48" />
    </VerticalStackLayout>
            </OnIdiom.Phone>

            <!-- Tablet/Desktop layout: two-column layout -->
            <OnIdiom.Tablet>
    <Grid MaximumWidthRequest="1200" HorizontalOptions="Center"
          ColumnDefinitions="55*,45*" ColumnSpacing="16" Padding="16,8">
        <!-- Left column: Weekly calendar + Nutrition summary + Add button -->
        <VerticalStackLayout Grid.Column="0" Spacing="12">
            <!-- Weekly calendar -->
            <controls:WeeklyCalendar
                AutomationId="WeeklyCalendar"
                SelectedDate="{Binding SelectedDate}"
                DatesWithPlans="{Binding DatesWithPlans}"
                DateSelectedCommand="{Binding DateSelectedCommand}" />

            <!-- Nutrition summary bar -->
            <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="12,8" Margin="0,4">
                <Grid ColumnDefinitions="*,*,*,*,*" HorizontalOptions="Fill">
                    <!-- Calorie -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="{Binding TotalCalories, StringFormat='{0}'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" />
                        <Label Text="Calorie"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Protein -->
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="{Binding TotalProtein, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#EF4444"
                               HorizontalOptions="Center" />
                        <Label Text="Protein"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Carb -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="{Binding TotalCarbs, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#F59E0B"
                               HorizontalOptions="Center" />
                        <Label Text="Carb"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Fat -->
                    <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                        <Label Text="{Binding TotalFat, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#10B981"
                               HorizontalOptions="Center" />
                        <Label Text="Fat"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Fiber -->
                    <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                        <Label Text="{Binding TotalFiber, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#8B5CF6"
                               HorizontalOptions="Center" />
                        <Label Text="Fiber"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Add diet plan button -->
            <Button AutomationId="AddMealPlanButton"
                    Text="+ Add Diet Plan"
                    FontAttributes="Bold"
                    Command="{Binding AddMealPlanCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,8"
                    HeightRequest="48" />
        </VerticalStackLayout>

        <!-- Right column: 2x2 meal grid -->
        <Grid Grid.Column="1" RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
            <!-- Breakfast - top left -->
            <controls:MealSlotView
                Grid.Row="0" Grid.Column="0"
                AutomationId="MealSlotBreakfast"
                MealType="Breakfast"
                Plans="{Binding BreakfastPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />

            <!-- Lunch - top right -->
            <controls:MealSlotView
                Grid.Row="0" Grid.Column="1"
                AutomationId="MealSlotLunch"
                MealType="Lunch"
                Plans="{Binding LunchPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />

            <!-- Dinner - bottom left -->
            <controls:MealSlotView
                Grid.Row="1" Grid.Column="0"
                AutomationId="MealSlotDinner"
                MealType="Dinner"
                Plans="{Binding DinnerPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />

            <!-- Snack - bottom right -->
            <controls:MealSlotView
                Grid.Row="1" Grid.Column="1"
                AutomationId="MealSlotSnack"
                MealType="Snack"
                Plans="{Binding SnackPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />
        </Grid>
    </Grid>
            </OnIdiom.Tablet>

            <!-- Desktop layout: same as tablet -->
            <OnIdiom.Desktop>
    <Grid MaximumWidthRequest="1200" HorizontalOptions="Center"
          ColumnDefinitions="55*,45*" ColumnSpacing="16" Padding="16,8">
        <!-- Left column: Weekly calendar + Nutrition summary + Add button -->
        <VerticalStackLayout Grid.Column="0" Spacing="12">
            <!-- Weekly calendar -->
            <controls:WeeklyCalendar
                AutomationId="WeeklyCalendar"
                SelectedDate="{Binding SelectedDate}"
                DatesWithPlans="{Binding DatesWithPlans}"
                DateSelectedCommand="{Binding DateSelectedCommand}" />

            <!-- Nutrition summary bar -->
            <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="12,8" Margin="0,4">
                <Grid ColumnDefinitions="*,*,*,*,*" HorizontalOptions="Fill">
                    <!-- Calorie -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="{Binding TotalCalories, StringFormat='{0}'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" />
                        <Label Text="Calorie"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Protein -->
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="{Binding TotalProtein, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#EF4444"
                               HorizontalOptions="Center" />
                        <Label Text="Protein"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Carb -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="{Binding TotalCarbs, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#F59E0B"
                               HorizontalOptions="Center" />
                        <Label Text="Carb"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Fat -->
                    <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                        <Label Text="{Binding TotalFat, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#10B981"
                               HorizontalOptions="Center" />
                        <Label Text="Fat"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <!-- Fiber -->
                    <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                        <Label Text="{Binding TotalFiber, StringFormat='{0}g'}"
                               FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                               TextColor="#8B5CF6"
                               HorizontalOptions="Center" />
                        <Label Text="Fiber"
                               FontSize="{DynamicResource Font11}"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Add diet plan button -->
            <Button AutomationId="AddMealPlanButton"
                    Text="+ Add Diet Plan"
                    FontAttributes="Bold"
                    Command="{Binding AddMealPlanCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,8"
                    HeightRequest="48" />
        </VerticalStackLayout>

        <!-- Right column: 2x2 meal grid -->
        <Grid Grid.Column="1" RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
            <!-- Breakfast - top left -->
            <controls:MealSlotView
                Grid.Row="0" Grid.Column="0"
                AutomationId="MealSlotBreakfast"
                MealType="Breakfast"
                Plans="{Binding BreakfastPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />

            <!-- Lunch - top right -->
            <controls:MealSlotView
                Grid.Row="0" Grid.Column="1"
                AutomationId="MealSlotLunch"
                MealType="Lunch"
                Plans="{Binding LunchPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />

            <!-- Dinner - bottom left -->
            <controls:MealSlotView
                Grid.Row="1" Grid.Column="0"
                AutomationId="MealSlotDinner"
                MealType="Dinner"
                Plans="{Binding DinnerPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />

            <!-- Snack - bottom right -->
            <controls:MealSlotView
                Grid.Row="1" Grid.Column="1"
                AutomationId="MealSlotSnack"
                MealType="Snack"
                Plans="{Binding SnackPlans}"
                ToggleCommand="{Binding ToggleMealCommand}" />
        </Grid>
    </Grid>
            </OnIdiom.Desktop>
        </OnIdiom>
    </ScrollView>
    </RefreshView>

        <!-- Guest login prompt overlay -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                              Spacing="16" Padding="32"
                              IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolConverter}}">
            <Label Text="&#xf023;" FontFamily="FA" FontSize="48"
                   TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                   HorizontalOptions="Center" />
            <Label Text="Please Login Check Diet Plan" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
            <Label Text="After Login Can Manage Your Diet Plan" FontSize="{DynamicResource Font14}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            <Button Text="Login Now"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    FontSize="{DynamicResource Font15}"
                    FontAttributes="Bold"
                    HeightRequest="44"
                    MinimumWidthRequest="160"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
