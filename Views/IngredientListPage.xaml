<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ssk.Controls"
             xmlns:viewmodels="clr-namespace:ssk.ViewModels"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Views.IngredientListPage"
             x:DataType="viewmodels:IngredientListViewModel"
             Title="食材冰箱">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid>
        <!-- 原有内容 -->
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}"
                     IsVisible="{Binding IsLoggedIn}">
        <Grid RowDefinitions="Auto,*,Auto" Padding="16,8"
              MaximumWidthRequest="{OnIdiom Phone=0, Tablet=900, Desktop=900}"
              HorizontalOptions="{OnIdiom Phone=Fill, Tablet=Center, Desktop=Center}">
        <!-- 分类标签 -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <HorizontalStackLayout Spacing="8">
                <Button AutomationId="CategoryAll"
                        Text="全部"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="全部"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
                <Button AutomationId="CategoryVegetable"
                        Text="蔬菜"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="蔬菜"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
                <Button AutomationId="CategoryFruit"
                        Text="水果"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="水果"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
                <Button AutomationId="CategoryMeat"
                        Text="肉类"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="肉类"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
                <Button AutomationId="CategorySeafood"
                        Text="海鲜"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="海鲜"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
                <Button AutomationId="CategoryDairy"
                        Text="蛋奶"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="蛋奶"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
                <Button AutomationId="CategoryStaple"
                        Text="主食"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="主食"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
                <Button AutomationId="CategoryCondiment"
                        Text="调味品"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="调味品"
                        FontSize="{DynamicResource Font13}"
                        Padding="16,6"
                        CornerRadius="18" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 食材列表 -->
        <CollectionView Grid.Row="1"
                        AutomationId="IngredientList"
                        ItemsSource="{Binding Ingredients}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="IngredientGridLayout"
                                 Orientation="Vertical"
                                 Span="1"
                                 HorizontalItemSpacing="8"
                                 VerticalItemSpacing="4" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView AutomationId="IngredientSwipe">
                        <SwipeView.RightItems>
                            <SwipeItem AutomationId="DeleteIngredientSwipe"
                                       Text="删除"
                                       BackgroundColor="#EF4444"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:IngredientListViewModel}}, Path=DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeView.RightItems>
                        <controls:IngredientCard Ingredient="{Binding .}"
                                                 TapCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:IngredientListViewModel}}, Path=NavigateToEditCommand}" />
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 添加食材按钮 -->
        <Button Grid.Row="2"
                AutomationId="AddIngredientButton"
                Text="+ 添加食材"
                FontAttributes="Bold"
                Command="{Binding NavigateToAddCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                CornerRadius="10"
                Margin="0,8,0,0"
                HeightRequest="48" />
    </Grid>
    </RefreshView>

        <!-- 游客登录提示覆盖层 -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                              Spacing="16" Padding="32"
                              IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolConverter}}">
            <Label Text="&#xf023;" FontFamily="FA" FontSize="48"
                   TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                   HorizontalOptions="Center" />
            <Label Text="请登录查看个人食材" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
            <Label Text="登录后可以管理您的食材冰箱" FontSize="{DynamicResource Font14}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            <Button Text="立即登录"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    FontSize="{DynamicResource Font15}"
                    FontAttributes="Bold"
                    HeightRequest="44"
                    MinimumWidthRequest="160"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
