<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ssk.ViewModels"
             xmlns:controls="clr-namespace:ssk.Controls"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Views.ShoppingListPage"
             x:DataType="viewmodels:ShoppingListViewModel"
             Title="购物清单">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid>
        <!-- 原有内容 -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="16,8" RowSpacing="12"
              MaximumWidthRequest="{OnIdiom Phone=0, Tablet=800, Desktop=800}"
              HorizontalOptions="{OnIdiom Phone=Fill, Tablet=Center, Desktop=Center}">
        <!-- 输入区 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,60,Auto" ColumnSpacing="8">
            <controls:VoiceEntry AutomationId="ItemNameEntry"
                   Grid.Column="0"
                   Placeholder="物品名称"
                   Text="{Binding NewItemName}"
                   FontSize="{DynamicResource Font14}" />
            <Entry AutomationId="ItemQuantityEntry"
                   Grid.Column="1"
                   Placeholder="数量"
                   Text="{Binding NewItemQuantity}"
                   Keyboard="Numeric"
                   FontSize="{DynamicResource Font14}" />
            <Button AutomationId="AddItemButton"
                    Grid.Column="2"
                    Text="+"
                    FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                    Command="{Binding AddItemCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    WidthRequest="48"
                    HeightRequest="44" />
        </Grid>

        <!-- 购物列表 -->
        <CollectionView Grid.Row="1"
                        AutomationId="ShoppingListCollection"
                        ItemsSource="{Binding GroupedItems}"
                        IsGrouped="True"
                        SelectionMode="None">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Key}"
                           FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="0,12,0,4" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="8,6" ColumnSpacing="12">
                        <!-- 名称 + 数量 -->
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="{DynamicResource Font15}"
                                   LineBreakMode="TailTruncation">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPurchased}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding QuantityDisplay}" FontSize="{DynamicResource Font12}"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        </VerticalStackLayout>

                        <!-- 已购买勾选 -->
                        <CheckBox Grid.Column="1"
                                  AutomationId="ItemPurchasedCheckBox"
                                  IsChecked="{Binding IsPurchased}"
                                  VerticalOptions="Center" />

                        <!-- 删除按钮 -->
                        <Button Grid.Column="2"
                                AutomationId="DeleteItemButton"
                                Text="&#xf00d;"
                                FontFamily="FA"
                                FontSize="14"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ShoppingListViewModel}}, Path=DeleteItemCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="Transparent"
                                TextColor="#EF4444"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
            <Button Grid.Column="0"
                    AutomationId="ClearPurchasedButton"
                    Text="清空已购买"
                    Command="{Binding ClearPurchasedCommand}"
                    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                    TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
                    CornerRadius="10"
                    HeightRequest="44" />
            <Label Grid.Column="1"
                   AutomationId="ShoppingStatsLabel"
                   FontSize="{DynamicResource Font14}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding TotalCount, StringFormat='共{0}项'}"/>
                        <Span Text=" "/>
                        <Span Text="{Binding PurchasedCount, StringFormat='已购{0}项'}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>
    </Grid>

        <!-- 游客登录提示覆盖层 -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                              Spacing="16" Padding="32"
                              IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolConverter}}">
            <Label Text="&#xf023;" FontFamily="FA" FontSize="48"
                   TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                   HorizontalOptions="Center" />
            <Label Text="请登录查看购物清单" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
            <Label Text="登录后可以管理您的购物清单" FontSize="{DynamicResource Font14}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            <Button Text="立即登录"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    FontSize="{DynamicResource Font15}"
                    FontAttributes="Bold"
                    HeightRequest="44"
                    MinimumWidthRequest="160"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
