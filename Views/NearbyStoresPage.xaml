<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ssk.ViewModels"
             x:Class="ssk.Views.NearbyStoresPage"
             Title="Nearby Store">

    <VerticalStackLayout Padding="16,8" Spacing="12">
        <!-- Current location card -->
        <Border AutomationId="LocationCard"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                Padding="16">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#15000000, Dark=#30000000}"
                        Offset="0,2" Radius="6" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="8">
                <!-- Title -->
                <Label Text="Current Location" FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />

                <!-- Longitude/Latitude -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Lng:" FontSize="{DynamicResource Font13}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    <Label Grid.Column="1" Text="{Binding Longitude, StringFormat='{0:F6}'}"
                           FontSize="{DynamicResource Font13}" FontFamily="Mono"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Lat:" FontSize="{DynamicResource Font13}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    <Label Grid.Column="1" Text="{Binding Latitude, StringFormat='{0:F6}'}"
                           FontSize="{DynamicResource Font13}" FontFamily="Mono"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                </Grid>

                <!-- Location status -->
                <Label Text="{Binding LocationStatus}"
                       FontSize="{DynamicResource Font12}"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

                <!-- Compass heading -->
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,4">
                    <Label Text="&#xf14e;" FontFamily="FA" FontSize="16"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding CompassHeading, StringFormat='{0}&#176;'}"
                           FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Store count stats -->
        <Label AutomationId="StoreCountLabel"
               Text="{Binding StoreCountText}"
               FontSize="{DynamicResource Font14}" FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
               Margin="0,4" />

        <!-- Store list -->
        <CollectionView AutomationId="StoreList"
                        ItemsSource="{Binding Stores}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="12" Margin="0,4">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#15000000, Dark=#30000000}"
                                    Offset="0,1" Radius="4" Opacity="0.12" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:NearbyStoresViewModel}}, Path=OpenStoreCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                            <!-- Type icon -->
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    WidthRequest="48" HeightRequest="48"
                                    VerticalOptions="Center">
                                <Label Text="{Binding TypeAbbr}" FontSize="{DynamicResource Font16}" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Store name + address -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Address}" FontSize="{DynamicResource Font12}"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>

                            <!-- Distance + coordinates -->
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        Padding="8,4" HorizontalOptions="End">
                                    <Label Text="{Binding Distance, StringFormat='{0}km'}"
                                           FontSize="{DynamicResource Font12}" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Border>
                                <Label Text="{Binding CoordinatesDisplay}" FontSize="10"
                                       FontFamily="Mono"
                                       TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                       Margin="0,2,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
