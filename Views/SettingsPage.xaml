                                        Command="{Binding SaveUserNameCommand}"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        FontSize="{DynamicResource Font13}" />
                            </Grid>
                            <Button Text="{Binding LoginButtonText}"
