                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        FontSize="{DynamicResource Font13}" />
                            </Grid>
                            <Button Text="{Binding LoginButtonText}"
                                    Command="{Binding LoginLogoutCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    CornerRadius="10"
                                    FontSize="{DynamicResource Font14}"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    MinimumWidthRequest="160"
                                    AutomationId="LoginLogoutButton" />
                        </VerticalStackLayout>
