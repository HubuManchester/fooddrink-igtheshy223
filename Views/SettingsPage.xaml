<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ssk.Controls"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Views.SettingsPage"
             Title="My">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <ScrollView Padding="16">
        <OnIdiom x:TypeArguments="View">
            <!-- Phone layout: original single column VerticalStackLayout -->
            <OnIdiom.Phone>
                <VerticalStackLayout Spacing="12">
                    <!-- User info area -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#15000000, Dark=#30000000}"
                                    Offset="0,2" Radius="6" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <!-- User icon -->
                            <Label Text="&#xf2bd;" FontFamily="FA" FontSize="56"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                            <!-- Logged in: show username + edit button -->
                            <Grid ColumnDefinitions="*,Auto" HorizontalOptions="Center" ColumnSpacing="12"
                                  IsVisible="{Binding ShowEditUserName}">
                                <Label Grid.Column="0" Text="{Binding DisplayUserName}" FontSize="{DynamicResource Font20}" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        AutomationId="EditUserNameButton"
                                        Text="&#xf044;" FontFamily="FA" FontSize="14"
                                        Command="{Binding ToggleEditUserNameCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Primary}"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0" />
                            </Grid>

                            <!-- Not logged in: show guest mode text -->
                            <Label Text="{Binding DisplayUserName}"
                                   FontSize="{DynamicResource Font20}" FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding ShowLoginButton}" />

                            <!-- Edit username area -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                  IsVisible="{Binding IsEditingUserName}">
                                <controls:VoiceEntry Grid.Column="0"
                                       AutomationId="UserNameEntry"
                                       Text="{Binding UserName}"
                                       FontSize="{DynamicResource Font15}"
                                       Placeholder="Input username" />
                                <Button Grid.Column="1"
                                        AutomationId="SaveUserNameButton"
                                        Text="Save"
                                        Command="{Binding SaveUserNameCommand}"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        FontSize="{DynamicResource Font13}" />
                            </Grid>

                            <!-- Login/Logout button -->
                            <Button Text="{Binding LoginButtonText}"
                                    Command="{Binding LoginLogoutCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    CornerRadius="10"
                                    FontSize="{DynamicResource Font14}"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    MinimumWidthRequest="160"
                                    AutomationId="LoginLogoutButton" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Theme setting -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16" Margin="0,4">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Theme Setting" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button AutomationId="ThemeLightButton"
                                        Text="Light"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="Light"
                                        FontSize="{DynamicResource Font13}" Padding="16,8" CornerRadius="8" />
                                <Button AutomationId="ThemeDarkButton"
                                        Text="Dark"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="Dark"
                                        FontSize="{DynamicResource Font13}" Padding="16,8" CornerRadius="8" />
                                <Button AutomationId="ThemeSystemButton"
                                        Text="System"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="System"
                                        FontSize="{DynamicResource Font13}" Padding="16,8" CornerRadius="8" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Font size -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16" Margin="0,4">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Font Size" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button AutomationId="FontSizeSmallButton"
                                        Text="S"
                                        Command="{Binding SetFontSizeCommand}"
                                        CommandParameter="Small"
                                        FontSize="{DynamicResource Font12}" Padding="16,8" CornerRadius="8" />
                                <Button AutomationId="FontSizeMediumButton"
                                        Text="M"
                                        Command="{Binding SetFontSizeCommand}"
                                        CommandParameter="Medium"
                                        FontSize="{DynamicResource Font14}" Padding="16,8" CornerRadius="8" />
                                <Button AutomationId="FontSizeLargeButton"
                                        Text="L"
                                        Command="{Binding SetFontSizeCommand}"
                                        CommandParameter="Large"
                                        FontSize="{DynamicResource Font16}" Padding="16,8" CornerRadius="8" />
                                <Button AutomationId="FontSizeExtraLargeButton"
                                        Text="XL"
                                        Command="{Binding SetFontSizeCommand}"
                                        CommandParameter="ExtraLarge"
                                        FontSize="{DynamicResource Font18}" Padding="16,8" CornerRadius="8" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Daily calorie target -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16" Margin="0,4">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Daily Calorie Target" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0"
                                       AutomationId="CalorieTargetEntry"
                                       Text="{Binding CaloriesGoal}"
                                       Keyboard="Numeric"
                                       Placeholder="Daily calorie target(kcal)"
                                       FontSize="{DynamicResource Font14}" />
                                <Button Grid.Column="1"
                                        AutomationId="SaveCalorieTargetButton"
                                        Text="Save"
                                        Command="{Binding SaveCaloriesGoalCommand}"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        FontSize="{DynamicResource Font13}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Function button list -->
                    <!-- About app -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AboutCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="&#xf05a;" FontFamily="FA" FontSize="18"
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="About App" FontSize="{DynamicResource Font15}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Reset data -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            Padding="16" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetDataCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="&#xf1f8;" FontFamily="FA" FontSize="18"
                                   TextColor="#EF4444" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Reset Data" FontSize="{DynamicResource Font15}"
                                   TextColor="#EF4444" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </OnIdiom.Phone>

            <!-- Tablet/Desktop layout: 2 column Grid -->
