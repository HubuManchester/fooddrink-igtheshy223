                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        FontSize="{DynamicResource Font13}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Row 2 Col 1: About app -->
                    <Border Grid.Row="2" Grid.Column="1"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
