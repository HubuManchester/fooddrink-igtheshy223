<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ssk.Controls.WeeklyCalendar"
             x:Name="This">
    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            Padding="12" Margin="4">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}" Offset="0,2" Radius="8" Opacity="0.3"/>
        </Border.Shadow>
        <Grid RowDefinitions="Auto,Auto,Auto"
              BindingContext="{x:Reference This}">
            <!-- Weekday Title Row -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,4">
                <Label Grid.Column="0" Text="M" HorizontalOptions="Center" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
                <Label Grid.Column="1" Text="T" HorizontalOptions="Center" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
                <Label Grid.Column="2" Text="W" HorizontalOptions="Center" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
                <Label Grid.Column="3" Text="T" HorizontalOptions="Center" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
                <Label Grid.Column="4" Text="F" HorizontalOptions="Center" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
                <Label Grid.Column="5" Text="S" HorizontalOptions="Center" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
                <Label Grid.Column="6" Text="S" HorizontalOptions="Center" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
            </Grid>
            <!-- Date Number Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*">
                <Button x:Name="Day0" Grid.Column="0" Clicked="OnDayClicked" FontSize="{DynamicResource Font14}" MinimumWidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
                <Button x:Name="Day1" Grid.Column="1" Clicked="OnDayClicked" FontSize="{DynamicResource Font14}" MinimumWidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
                <Button x:Name="Day2" Grid.Column="2" Clicked="OnDayClicked" FontSize="{DynamicResource Font14}" MinimumWidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
                <Button x:Name="Day3" Grid.Column="3" Clicked="OnDayClicked" FontSize="{DynamicResource Font14}" MinimumWidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
                <Button x:Name="Day4" Grid.Column="4" Clicked="OnDayClicked" FontSize="{DynamicResource Font14}" MinimumWidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
                <Button x:Name="Day5" Grid.Column="5" Clicked="OnDayClicked" FontSize="{DynamicResource Font14}" MinimumWidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
                <Button x:Name="Day6" Grid.Column="6" Clicked="OnDayClicked" FontSize="{DynamicResource Font14}" MinimumWidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
            </Grid>
            <!-- Plan Dot Row -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="8">
                <BoxView x:Name="Dot0" Grid.Column="0" WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="Transparent" HorizontalOptions="Center"/>
                <BoxView x:Name="Dot1" Grid.Column="1" WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="Transparent" HorizontalOptions="Center"/>
                <BoxView x:Name="Dot2" Grid.Column="2" WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="Transparent" HorizontalOptions="Center"/>
                <BoxView x:Name="Dot3" Grid.Column="3" WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="Transparent" HorizontalOptions="Center"/>
                <BoxView x:Name="Dot4" Grid.Column="4" WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="Transparent" HorizontalOptions="Center"/>
                <BoxView x:Name="Dot5" Grid.Column="5" WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="Transparent" HorizontalOptions="Center"/>
                <BoxView x:Name="Dot6" Grid.Column="6" WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="Transparent" HorizontalOptions="Center"/>
            </Grid>
        </Grid>
    </Border>
</ContentView>
