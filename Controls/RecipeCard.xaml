<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Controls.RecipeCard"
             x:Name="This">
    <ContentView.Resources>
        <converters:StringToUriConverter x:Key="StringToUriConverter"/>
        <converters:BoolToColorConverter x:Key="FavoriteColorConverter" TrueColor="#EF4444" FalseColor="#9CA3AF"/>
    </ContentView.Resources>

    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            Padding="0" Margin="4">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}" Offset="0,2" Radius="8" Opacity="0.3"/>
        </Border.Shadow>

        <Grid RowDefinitions="120,Auto,Auto" BindingContext="{x:Reference This}">
            <!-- Image Area -->
            <Grid Grid.Row="0">
                <!-- Error Placeholder -->
                <Border StrokeShape="RoundRectangle 12,12,0,0" BackgroundColor="#F3F4F6">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="&#xf127;" FontFamily="FA" FontSize="24" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                        <Label Text="Image Load Fail" FontSize="10" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                        <Label Text="Please Check Network" FontSize="9" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <!-- Network Image -->
                <Image Source="{Binding Recipe.ImagePath, Converter={StaticResource StringToUriConverter}}"
                       Aspect="AspectFill" HeightRequest="120"/>
                <!-- Category Tag -->
                <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="8,8"
                        StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Primary}"
                        Padding="8,3">
                    <Label Text="{Binding Recipe.Category}" TextColor="White" FontSize="{DynamicResource Font11}"/>
                </Border>
                <!-- Favorite Icon -->
                <Label FontFamily="FA" Text="&#xf004;" FontSize="16"
                       TextColor="{Binding Recipe.IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                       HorizontalOptions="End" VerticalOptions="End" Margin="0,0,8,8">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FavoriteCommand}"
                                              CommandParameter="{Binding Recipe}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Title -->
            <Label Grid.Row="1" Text="{Binding Recipe.Title}" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                   LineBreakMode="TailTruncation" Margin="8,8,8,2"/>

            <!-- Difficulty + Time -->
            <HorizontalStackLayout Grid.Row="2" Margin="8,0,8,8" Spacing="8">
                <Label Text="{Binding Recipe.Difficulty}" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
                <Label Text="·" FontSize="{DynamicResource Font12}" TextColor="#D1D5DB"/>
                <Label Text="{Binding Recipe.CookTimeMin, StringFormat='{0} min'}" FontSize="{DynamicResource Font12}" TextColor="#6B7280"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
