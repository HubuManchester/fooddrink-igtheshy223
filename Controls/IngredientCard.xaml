<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Controls.IngredientCard"
             x:Name="This">
    <ContentView.Resources>
        <converters:ExpiryToColorConverter x:Key="ExpiryColor"/>
        <converters:ExpiryToTextConverter x:Key="ExpiryText"/>
        <converters:NotNullConverter x:Key="NotNullConverter"/>
    </ContentView.Resources>
    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            Padding="12" Margin="4,2">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#15000000, Dark=#30000000}" Offset="0,1" Radius="4" Opacity="0.2"/>
        </Border.Shadow>
        <Grid ColumnDefinitions="48,*,Auto" BindingContext="{x:Reference This}" ColumnSpacing="12">
            <!-- 分类图标 -->
            <Border Grid.Column="0" StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource PrimaryLight}"
                    WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                <Label Text="{Binding CategoryAbbr}" FontSize="{DynamicResource Font14}" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- 名称+数量 -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding Ingredient.Name}" FontSize="{DynamicResource Font15}" FontAttributes="Bold"
                       LineBreakMode="TailTruncation"/>
                <Label Text="{Binding Ingredient.QuantityDisplay}" FontSize="{DynamicResource Font13}" TextColor="#6B7280"/>
            </VerticalStackLayout>

            <!-- 过期徽章 -->
            <Border Grid.Column="2" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{Binding Ingredient.ExpiryDate, Converter={StaticResource ExpiryColor}}"
                    Padding="8,4" VerticalOptions="Center"
                    IsVisible="{Binding Ingredient.ExpiryDate, Converter={StaticResource NotNullConverter}}">
                <Label Text="{Binding Ingredient.ExpiryDate, Converter={StaticResource ExpiryText}}"
                       TextColor="White" FontSize="{DynamicResource Font11}"/>
            </Border>
        </Grid>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={x:Reference This}, Path=TapCommand}"
                                  CommandParameter="{Binding Source={x:Reference This}, Path=Ingredient}"/>
        </Border.GestureRecognizers>
    </Border>
</ContentView>
