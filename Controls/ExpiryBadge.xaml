<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ssk.Converters"
             x:Class="ssk.Controls.ExpiryBadge"
             x:Name="This">
    <ContentView.Resources>
        <converters:ExpiryToColorConverter x:Key="ExpiryColor"/>
        <converters:ExpiryToTextConverter x:Key="ExpiryText"/>
        <converters:NotNullConverter x:Key="NotNullConverter"/>
    </ContentView.Resources>
    <Border StrokeShape="RoundRectangle 10"
            BackgroundColor="{Binding ExpiryDate, Source={x:Reference This}, Converter={StaticResource ExpiryColor}}"
            Padding="8,4" IsVisible="{Binding ExpiryDate, Source={x:Reference This}, Converter={StaticResource NotNullConverter}}">
        <Label Text="{Binding ExpiryDate, Source={x:Reference This}, Converter={StaticResource ExpiryText}}"
               TextColor="White" FontSize="{DynamicResource Font11}"/>
    </Border>
</ContentView>
