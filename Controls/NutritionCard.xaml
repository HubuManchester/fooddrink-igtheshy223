<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ssk.Models"
             x:Class="ssk.Controls.NutritionCard"
             x:Name="This">
    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            Padding="16" Margin="4">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}" Offset="0,2" Radius="8" Opacity="0.3"/>
        </Border.Shadow>
        <VerticalStackLayout BindingContext="{x:Reference This}">
            <Label Text="Nutrition Info" FontSize="{DynamicResource Font16}" FontAttributes="Bold" Margin="0,0,0,12"/>
            <Grid ColumnDefinitions="*,*,*,*,*">
                <!-- Calorie -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="{Binding Calories, StringFormat='{0:F0}'}" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                    <Label Text="Calorie" FontSize="{DynamicResource Font12}" TextColor="#6B7280" HorizontalOptions="Center"/>
                    <Label Text="kcal" FontSize="10" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <!-- Protein -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding Protein, StringFormat='{0:F0}'}" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                           TextColor="#EC4899" HorizontalOptions="Center"/>
                    <Label Text="Protein" FontSize="{DynamicResource Font12}" TextColor="#6B7280" HorizontalOptions="Center"/>
                    <Label Text="gram" FontSize="10" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <!-- Carb -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="{Binding Carbs, StringFormat='{0:F0}'}" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                           TextColor="#F97316" HorizontalOptions="Center"/>
                    <Label Text="Carb" FontSize="{DynamicResource Font12}" TextColor="#6B7280" HorizontalOptions="Center"/>
                    <Label Text="gram" FontSize="10" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <!-- Fat -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                    <Label Text="{Binding Fat, StringFormat='{0:F0}'}" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                           TextColor="#22C55E" HorizontalOptions="Center"/>
                    <Label Text="Fat" FontSize="{DynamicResource Font12}" TextColor="#6B7280" HorizontalOptions="Center"/>
                    <Label Text="gram" FontSize="10" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <!-- Fiber -->
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                    <Label Text="{Binding Fiber, StringFormat='{0:F0}'}" FontSize="{DynamicResource Font18}" FontAttributes="Bold"
                           TextColor="#3B82F6" HorizontalOptions="Center"/>
                    <Label Text="Fiber" FontSize="{DynamicResource Font12}" TextColor="#6B7280" HorizontalOptions="Center"/>
                    <Label Text="gram" FontSize="10" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
